<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Player"
        Height="650"
        Width="900"
        Background="#0d1117"
        Foreground="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Music Player"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Margin="0,0,10,0">
                <TextBlock Text="Library"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <ListBox ItemsSource="{Binding Tracks}"
         SelectedItem="{Binding SelectedTrack}"
         Height="260"
         DisplayMemberPath="Title"/>

                <Button Content="Add Files"
        Command="{Binding AddFilesCommand}"
        Height="35"
        Margin="0,10,0,20"/>
                
                <TextBlock Text="Playback Mode"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,20,0,8"/>

                <StackPanel>
                    <Button Content="Sequential"
                            Command="{Binding SequentialCommand}"
                            Margin="0,2"/>

                    <Button Content="Shuffle"
                            Command="{Binding ShuffleCommand}"
                            Margin="0,2"/>

                    <Button Content="Smart Shuffle"
                            Command="{Binding SmartShuffleCommand}"
                            Margin="0,2"/>

                    <Button Content="Repeat One"
                            Command="{Binding RepeatOneCommand}"
                            Margin="0,2"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0">
                <TextBlock Text="Now Playing"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding CurrentTrack.Title}"
                           FontSize="22"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding CurrentTrack.Artist}"
                           FontSize="16"
                           Foreground="LightGray"/>

                <TextBlock Text="{Binding State}"
                           FontSize="14"
                           Margin="0,10,0,0"/>

                <TextBlock Text="{Binding StrategyName}"
                           FontSize="14"
                           Foreground="LightGreen"/>

                <TextBlock Text="History"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,25,0,8"/>

                <ListBox ItemsSource="{Binding History}"
                         Height="260"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">
            <Button Content="Previous"
                    Command="{Binding PreviousCommand}"
                    Width="90"
                    Margin="4"/>

            <Button Content="Play"
                    Command="{Binding PlayCommand}"
                    Width="90"
                    Margin="4"/>

            <Button Content="Pause"
                    Command="{Binding PauseCommand}"
                    Width="90"
                    Margin="4"/>

            <Button Content="Next"
                    Command="{Binding NextCommand}"
                    Width="90"
                    Margin="4"/>

            <Button Content="Undo"
                    Command="{Binding UndoCommand}"
                    Width="90"
                    Margin="4"/>

            <Button Content="Redo"
                    Command="{Binding RedoCommand}"
                    Width="90"
                    Margin="4"/>
        </StackPanel>
    </Grid>
</Window>